{
  "name": "nfc-portfolio-card",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test",
    "format": "prettier --write \"*.{html,json}\" \"src/**/*.{js,css,md}\" \"tests/**/*.js\"",
    "content": "node scripts/generate-content.mjs",
    "predev": "npm run content",
    "prebuild": "npm run content",
    "preview": "vite preview --host 127.0.0.1",
    "verify:content": "node scripts/generate-content.mjs --check",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify": "npm run verify:content && npm test && npm run build && npm run verify:assets",
    "wip": "node scripts/list-wip.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
